rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'byabdullahkhan@gmail.com';
    }

    // User profiles: authenticated users can read profiles (to view teacher/creator usernames), write own profile, or super admin full control
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }

    // Site Activity feed: real-time activity log
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // Tests: anyone can read tests to take an exam.
    // Authenticated creators can create and manage their own tests. Super admin has full control.
    match /tests/{testId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.creatorUid == request.auth.uid || 
        resource.data.creatorEmail == request.auth.token.email || 
        isSuperAdmin()
      );
    }

    // Submissions: candidates can submit answers (anyone can create).
    // Test owners, submitting users, and super admin can read submission records.
    match /submissions/{submissionId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null;
    }

    // Email logs: authenticated users can read their own logs or super admin
    match /email_logs/{logId} {
      allow read, create: if request.auth != null && (
        request.resource.data.recipientUid == request.auth.uid || 
        resource.data.recipientUid == request.auth.uid ||
        isSuperAdmin()
      );
      allow write: if request.auth != null;
    }
  }
}

